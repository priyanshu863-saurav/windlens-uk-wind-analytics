# WindLens Environment Variables

# Backend API Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://windlens-uk-wind-analytics.vercel.app

# Elexon BMRS API
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=30
ELEXON_MAX_RETRIES=3

# Forecast Analytics Configuration
# Default day-ahead purchasing decision cutoff in UTC (e.g. 12:00:00 on D-1)
DEFAULT_DECISION_CUTOFF_HOUR=12
DEFAULT_DECISION_CUTOFF_MINUTE=0

# Frontend Configuration
# Development: leave empty to use Vite dev server proxy (http://localhost:8000)
# Production: https://windlens-backend.onrender.com
VITE_API_BASE_URL=https://windlens-backend.onrender.com
